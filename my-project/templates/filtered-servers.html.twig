{% extends './base.html.twig' %}

{% block title %}Servers Available{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            <div class="container">
                <div class="row d-flex d-flex justify-content-between align-items-center my-3">
                    <h1 class="col-md-3">Servers</h1>
                    <form id="filter-form" class="col-md-9">
                        <div class="form-row d-flex m-1 gap-1 justify-content-end">
                            <div class="col-md-2">
                                <label for="location">Location</label>
                                <select class="form-control" id="location" name="location">
                                    <option value="">Select Location</option>
                                    {% for location in filters.location %}
                                        <option value="{{ location }}">{{ location }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-1">
                                <label for="ram">RAM</label>
                                <select class="form-control" id="ram" name="ram">
                                    <option value="">Qty Ram</option>
                                    {% for ram in filters.ram %}
                                        <option value="{{ ram }}">{{ ram }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-1">
                                <label for="ram">TYPE RAM</label>
                                <select class="form-control" id="ram_type" name="ram_type">
                                    <option value="">Type Ram</option>
                                    {% for ram_type in filters.ram_type %}
                                        <option value="{{ ram_type }}">{{ ram_type }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-1">
                                <label for="hdd">HDD</label>
                                <select class="form-control" id="hdd" name="hdd">
                                    <option value="">Size HDD</option>
                                    {% for hdd in filters.hdd %}
                                        <option value="{{ hdd }}">{{ hdd }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-1">
                                <label for="hdd_type">TYPE HDD</label>
                                <select class="form-control" id="hdd_type" name="hdd_type">
                                    <option value="">Type HDD</option>
                                    {% for hdd_type in filters.hdd_type %}
                                        <option value="{{ hdd_type }}">{{ hdd_type }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-1">
                                <button type="button" class="btn btn-primary mt-4" id="filter-btn">Filter</button>
                            </div>
                        </div>
                    </form>
                </div>
                <table id="servers-table" class="table mb-5">
                    <thead>
                        <tr> 
                            {% set itemsOrder = ['Model', 'RAM', 'RAM_TYPE', 'HDD', 'HDD_TYPE', 'Location', 'Price'] %}
                            {% set serverItems = servers[0] %}
                            {% for item in itemsOrder %}
                                <th>{{ serverItems[item] }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for server in servers|slice(1) %}
                            <tr>
                                <td>{{ server.Model }}</td>
                                <td>{{ server.RAM }}</td>
                                <td>{{ server.RAM_TYPE }}</td>
                                <td>{{ server.HDD }}</td>
                                <td>{{ server.HDD_TYPE }}</td>
                                <td>{{ server.Location }}</td>
                                <td>{{ server.Price }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('filter-btn').addEventListener('click', function() {
            var form = document.getElementById('filter-form');
            var formData = new FormData(form);
            var xhr = new XMLHttpRequest();
            xhr.open('POST', '/api/filter-servers', true);
            xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
            xhr.onload = function() {
                if (xhr.status === 200) {
                    var servers = JSON.parse(xhr.responseText);
                    updateServersTable(servers);
                } else {
                    console.error('Request failed. Status: ' + xhr.status);
                }
            };
            xhr.onerror = function() {
                console.error('Request failed');
            };
            xhr.send(formData);
        });

        var originalColumnOrder;

        function saveOriginalColumnOrder() {
            var headerCells = document.getElementById('servers-table').getElementsByTagName('thead')[0].getElementsByTagName('th');
            originalColumnOrder = Array.from(headerCells).map(function(cell) {
                return cell.textContent.trim();
            });
        }

        function updateServersTable(servers) {
            var tableBody = document.getElementById('servers-table').getElementsByTagName('tbody')[0];
            tableBody.innerHTML = '';
            
            if (!originalColumnOrder) {
                saveOriginalColumnOrder();
            }

            for (var i = 1; i < servers.length; i++) {
                var server = servers[i];
                var row = document.createElement('tr');
                originalColumnOrder.forEach(function(column) {
                    var cell = document.createElement('td');
                    cell.textContent = server[column];
                    row.appendChild(cell);
                });
                tableBody.appendChild(row);
            }
        }
    </script>
{% endblock %}
